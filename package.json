{
  "name": "voidkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voidkit - Dark, minimal developer utility toolkit built with SvelteKit",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.34",
    "dompurify": "^3.3.3",
    "lucide-svelte": "^0.470.0",
    "marked": "^18.0.0",
    "qrcode": "^1.5.4"
  }
}
